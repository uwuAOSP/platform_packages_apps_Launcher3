<com.android.launcher3.allapps.AllAppsFolderIcon
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_all_apps_folder_preview"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:focusable="true">

    <GridLayout
        android:id="@+id/all_apps_folder_preview_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:columnCount="2"
        android:rowCount="2" />

    <com.android.launcher3.views.DoubleShadowBubbleTextView
        android:id="@+id/folder_icon_name"
        style="@style/BaseIcon.AllApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:focusable="false"
        launcher:iconDisplay="all_apps" />
</com.android.launcher3.allapps.AllAppsFolderIcon>
